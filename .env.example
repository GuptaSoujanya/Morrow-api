# Generate unique local values with: uv run morrow init-local
# Never commit the generated .env or .runtime directory.
DATABASE_URL=postgresql://morrow_app:CHANGE_ME@127.0.0.1:15433/morrow
# Used only by CLI migration/provisioning/import commands, never passed to the API container.
DATABASE_OWNER_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15433/morrow
POSTGRES_PASSWORD=CHANGE_ME
APP_DATABASE_PASSWORD=CHANGE_ME
ARTIFACT_BACKEND=local
ARTIFACT_ROOT=.runtime/artifacts
MAX_ARTIFACT_BYTES=10485760
SESSION_HOURS=12
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# S3 deployment: set ARTIFACT_BACKEND=s3 and provision a private bucket first.
S3_BUCKET=
S3_REGION=us-east-1
# Empty for AWS; set an HTTPS URL for another S3-compatible provider.
S3_ENDPOINT_URL=
# Use the standard AWS credential chain or a workload role. Do not add keys to Git.
