# Generate unique local values with: uv run morrow init-local
# Never commit the generated .env or .runtime directory.
DATABASE_URL=postgresql://morrow_app:CHANGE_ME@127.0.0.1:15433/morrow
# Used only by CLI migration/provisioning/import commands, never passed to the API container.
DATABASE_OWNER_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:15433/morrow
POSTGRES_PASSWORD=CHANGE_ME
APP_DATABASE_PASSWORD=CHANGE_ME
ARTIFACT_BACKEND=local
ARTIFACT_ROOT=.runtime/artifacts
MAX_ARTIFACT_BYTES=10485760
SESSION_HOURS=12
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# Public dashboard origin. The dashboard proxies /api/v1/* to this API.
PUBLIC_ORIGIN=http://127.0.0.1:8100
COOKIE_SECURE=false
AUTH_PROVIDER=local
# Requests through the dashboard share its IP; cap all auth attempts per 15 minutes.
# Each individual identifier remains limited to 10 attempts in that window.
AUTH_IP_ATTEMPT_LIMIT=1000
# Firebase mode handles Google, email verification, and recovery without SMTP.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Backend-only ADC credential path; never put the JSON key in frontend code or Git.
# For containers, mount the key read-only and use its container path here.
GOOGLE_APPLICATION_CREDENTIALS=
# Host file for optional compose.firebase.yaml (mounted read-only as a secret).
FIREBASE_CREDENTIALS_FILE=
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# file writes private .eml previews; smtp or resend delivers real transactional email.
MAIL_BACKEND=file
MAIL_ROOT=.runtime/mail
MAIL_FROM=Morrow <hello@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional Resend API transport: verify a domain you own and set MAIL_FROM to that domain.
# Free tier: 3,000 emails/month, maximum 100/day across all recipients (check current limits).
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map Stripe monthly INR prices to Plus and Pro in the administrator plan editor.
# S3 deployment: set ARTIFACT_BACKEND=s3 and provision a private bucket first.
S3_BUCKET=
S3_REGION=us-east-1
# Empty for AWS; set an HTTPS URL for another S3-compatible provider.
S3_ENDPOINT_URL=
# Use the standard AWS credential chain or a workload role. Do not add keys to Git.
